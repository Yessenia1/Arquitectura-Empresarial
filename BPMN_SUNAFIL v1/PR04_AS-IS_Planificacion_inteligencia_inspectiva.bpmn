<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR04_ASIS" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR04_ASIS">
    <bpmn:documentation></bpmn:documentation>
    <bpmn:participant id="Participant_PR04_ASIS" name="SUNAFIL - PR04 Planificación e inteligencia inspectiva (AS-IS)" processRef="Process_PR04_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR04_ASIS" name="PR04 AS-IS - Planificación e inteligencia inspectiva" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR04_ASIS">
      <bpmn:lane id="Lane_PR04_ASIS_DINI" name="Dirección de Inteligencia Inspectiva (DINI)">
        <bpmn:flowNodeRef>PR04_ASIS_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_ASIS_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_ASIS_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_ASIS_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_ASIS_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_ASIS_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_ASIS_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR04_ASIS_TI" name="Oficina de TI">
        <bpmn:flowNodeRef>PR04_ASIS_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR04_ASIS_INT" name="Intendencias (Lima y regiones)">
        <bpmn:flowNodeRef>PR04_ASIS_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_ASIS_t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR04_ASIS_s" name="Inicio del ciclo anual de planificación">
      <bpmn:outgoing>Flow_PR04_ASIS_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_PR04_ASIS_s" />
    </bpmn:startEvent>
    <bpmn:userTask id="PR04_ASIS_t1" name="Solicitar bases de datos a TI y entidades externas">
      <bpmn:incoming>Flow_PR04_ASIS_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="PR04_ASIS_t2" name="Extraer datos y enviar archivos Excel">
      <bpmn:incoming>Flow_PR04_ASIS_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR04_ASIS_t3" name="Consolidar y depurar datos en hojas de cálculo">
      <bpmn:incoming>Flow_PR04_ASIS_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR04_ASIS_t4" name="Seleccionar sectores y empresas por criterio experto">
      <bpmn:incoming>Flow_PR04_ASIS_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="PR04_ASIS_t5" name="Elaborar Plan Anual de Inspección del Trabajo">
      <bpmn:incoming>Flow_PR04_ASIS_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PR04_ASIS_t6" name="Programar operativos según inspectores disponibles">
      <bpmn:incoming>Flow_PR04_ASIS_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="PR04_ASIS_t7" name="Ejecutar operativos y reportar resultados en Excel">
      <bpmn:incoming>Flow_PR04_ASIS_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR04_ASIS_t8" name="Consolidar resultados manualmente">
      <bpmn:incoming>Flow_PR04_ASIS_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_ASIS_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="PR04_ASIS_e" name="Informe de resultados trimestral">
      <bpmn:incoming>Flow_PR04_ASIS_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_1" sourceRef="PR04_ASIS_s" targetRef="PR04_ASIS_t1" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_2" sourceRef="PR04_ASIS_t1" targetRef="PR04_ASIS_t2" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_3" sourceRef="PR04_ASIS_t2" targetRef="PR04_ASIS_t3" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_4" sourceRef="PR04_ASIS_t3" targetRef="PR04_ASIS_t4" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_5" sourceRef="PR04_ASIS_t4" targetRef="PR04_ASIS_t5" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_6" sourceRef="PR04_ASIS_t5" targetRef="PR04_ASIS_t6" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_7" sourceRef="PR04_ASIS_t6" targetRef="PR04_ASIS_t7" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_8" sourceRef="PR04_ASIS_t7" targetRef="PR04_ASIS_t8" />
    <bpmn:sequenceFlow id="Flow_PR04_ASIS_9" sourceRef="PR04_ASIS_t8" targetRef="PR04_ASIS_e" />
    <bpmn:textAnnotation id="Ann_PR04_ASIS_1"><bpmn:text>Datos con semanas de desfase</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR04_ASIS_1" associationDirection="None" sourceRef="Ann_PR04_ASIS_1" targetRef="PR04_ASIS_t2" />
    <bpmn:textAnnotation id="Ann_PR04_ASIS_2"><bpmn:text>Hojas de cálculo: errores y sin trazabilidad</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR04_ASIS_2" associationDirection="None" sourceRef="Ann_PR04_ASIS_2" targetRef="PR04_ASIS_t3" />
    <bpmn:textAnnotation id="Ann_PR04_ASIS_3"><bpmn:text>Selección sin modelo de riesgo</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR04_ASIS_3" associationDirection="None" sourceRef="Ann_PR04_ASIS_3" targetRef="PR04_ASIS_t4" />
    <bpmn:textAnnotation id="Ann_PR04_ASIS_4"><bpmn:text>Resultados tardíos; poca retroalimentación</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR04_ASIS_4" associationDirection="None" sourceRef="Ann_PR04_ASIS_4" targetRef="PR04_ASIS_t8" />
  </bpmn:process>
