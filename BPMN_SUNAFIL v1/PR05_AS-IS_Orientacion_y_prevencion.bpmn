<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR05_ASIS" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR05_ASIS">
    <bpmn:documentation></bpmn:documentation>
    <bpmn:participant id="Participant_PR05_ASIS" name="SUNAFIL - PR05 Orientación y prevención (AS-IS)" processRef="Process_PR05_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR05_ASIS" name="PR05 AS-IS - Orientación y prevención del cumplimiento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR05_ASIS">
      <bpmn:lane id="Lane_PR05_ASIS_CIU" name="Empleador / trabajador">
        <bpmn:flowNodeRef>PR05_ASIS_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR05_ASIS_ORI" name="Orientador (Prevención y Promoción / Intendencia)">
        <bpmn:flowNodeRef>PR05_ASIS_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR05_ASIS_INS" name="Área de inspección">
        <bpmn:flowNodeRef>PR05_ASIS_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_ASIS_e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR05_ASIS_s" name="Necesidad de orientación o caso detectado">
      <bpmn:outgoing>Flow_PR05_ASIS_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="PR05_ASIS_t1" name="Acudir a oficina o llamar a la central telefónica">
      <bpmn:incoming>Flow_PR05_ASIS_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR05_ASIS_t2" name="Absolver consulta sin registro estructurado">
      <bpmn:incoming>Flow_PR05_ASIS_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="PR05_ASIS_x1" name="¿Requiere acción preventiva?">
      <bpmn:incoming>Flow_PR05_ASIS_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR05_ASIS_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PR05_ASIS_e1" name="Consulta atendida">
      <bpmn:incoming>Flow_PR05_ASIS_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="PR05_ASIS_t3" name="Enviar carta inductiva">
      <bpmn:incoming>Flow_PR05_ASIS_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="PR05_ASIS_t4" name="Corregir incumplimiento (sin plazo verificable)">
      <bpmn:incoming>Flow_PR05_ASIS_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR05_ASIS_t5" name="Verificar subsanación manualmente">
      <bpmn:incoming>Flow_PR05_ASIS_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="PR05_ASIS_x2" name="¿Subsanó?">
      <bpmn:incoming>Flow_PR05_ASIS_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR05_ASIS_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PR05_ASIS_e2" name="Caso cerrado">
      <bpmn:incoming>Flow_PR05_ASIS_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PR05_ASIS_t6" name="Evaluar caso y solicitar orden de inspección">
      <bpmn:incoming>Flow_PR05_ASIS_10</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_ASIS_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PR05_ASIS_e3" name="Derivado a fiscalización">
      <bpmn:incoming>Flow_PR05_ASIS_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_1" sourceRef="PR05_ASIS_s" targetRef="PR05_ASIS_t1" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_2" sourceRef="PR05_ASIS_t1" targetRef="PR05_ASIS_t2" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_3" sourceRef="PR05_ASIS_t2" targetRef="PR05_ASIS_x1" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_4" name="No" sourceRef="PR05_ASIS_x1" targetRef="PR05_ASIS_e1" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_5" name="Sí" sourceRef="PR05_ASIS_x1" targetRef="PR05_ASIS_t3" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_6" sourceRef="PR05_ASIS_t3" targetRef="PR05_ASIS_t4" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_7" sourceRef="PR05_ASIS_t4" targetRef="PR05_ASIS_t5" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_8" sourceRef="PR05_ASIS_t5" targetRef="PR05_ASIS_x2" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_9" name="Sí" sourceRef="PR05_ASIS_x2" targetRef="PR05_ASIS_e2" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_10" name="No" sourceRef="PR05_ASIS_x2" targetRef="PR05_ASIS_t6" />
    <bpmn:sequenceFlow id="Flow_PR05_ASIS_11" sourceRef="PR05_ASIS_t6" targetRef="PR05_ASIS_e3" />
    <bpmn:textAnnotation id="Ann_PR05_ASIS_1"><bpmn:text>Atención presencial/telefónica limitada</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR05_ASIS_1" associationDirection="None" sourceRef="Ann_PR05_ASIS_1" targetRef="PR05_ASIS_t1" />
    <bpmn:textAnnotation id="Ann_PR05_ASIS_2"><bpmn:text>Sin registro: no se mide la demanda</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR05_ASIS_2" associationDirection="None" sourceRef="Ann_PR05_ASIS_2" targetRef="PR05_ASIS_t2" />
    <bpmn:textAnnotation id="Ann_PR05_ASIS_3"><bpmn:text>Verificación manual, a veces no se realiza</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR05_ASIS_3" associationDirection="None" sourceRef="Ann_PR05_ASIS_3" targetRef="PR05_ASIS_t5" />
  </bpmn:process>
