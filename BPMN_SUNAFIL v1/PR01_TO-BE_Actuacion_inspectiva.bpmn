<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR01_TOBE" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR01_TOBE">
    <bpmn:documentation>Proceso crítico rediseñado: asignación automática, expediente digital, SIIT Móvil, firma digital.</bpmn:documentation>
    <bpmn:participant id="Participant_PR01_TOBE" name="SUNAFIL - PR01 Actuación inspectiva (TO-BE)" processRef="Process_PR01_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR01_TOBE" name="PR01 TO-BE - Actuación inspectiva" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR01_TOBE">
      <bpmn:lane id="Lane_PR01_TOBE_SYS" name="Plataforma Única de Gestión Inspectiva (sistema)">
        <bpmn:flowNodeRef>PR01_TOBE_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_st1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_st2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_st3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_st5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_st4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR01_TOBE_SUP" name="Supervisor inspector">
        <bpmn:flowNodeRef>PR01_TOBE_t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR01_TOBE_INS" name="Inspector del trabajo">
        <bpmn:flowNodeRef>PR01_TOBE_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_snd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR01_TOBE_EMP" name="Empleador (sujeto inspeccionado)">
        <bpmn:flowNodeRef>PR01_TOBE_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR01_TOBE_t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR01_TOBE_s" name="Orden de inspección generada (priorizada por riesgo)">
      <bpmn:outgoing>Flow_PR01_TOBE_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_PR01_TOBE_s" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="PR01_TOBE_st1" name="Asignar inspector según carga, ubicación y especialidad">
      <bpmn:incoming>Flow_PR01_TOBE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PR01_TOBE_st2" name="Consolidar expediente digital vía PIDE (SUNAT, planilla, antecedentes)">
      <bpmn:incoming>Flow_PR01_TOBE_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR01_TOBE_t1" name="Revisar expediente digital en SIIT Móvil">
      <bpmn:incoming>Flow_PR01_TOBE_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PR01_TOBE_t2" name="Ejecutar visita con SIIT Móvil (actas digitales, fotos, geolocalización)">
      <bpmn:incoming>Flow_PR01_TOBE_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="PR01_TOBE_snd" name="Requerir información por casilla electrónica">
      <bpmn:incoming>Flow_PR01_TOBE_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="PR01_TOBE_t3" name="Cargar documentos en la casilla / portal">
      <bpmn:incoming>Flow_PR01_TOBE_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR01_TOBE_st3" name="Validar documentos y cruzar datos automáticamente">
      <bpmn:incoming>Flow_PR01_TOBE_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR01_TOBE_t4" name="Evaluar hallazgos con lista de verificación digital">
      <bpmn:incoming>Flow_PR01_TOBE_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PR01_TOBE_x1" name="¿Infracciones verificadas?">
      <bpmn:incoming>Flow_PR01_TOBE_9</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR01_TOBE_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PR01_TOBE_t5" name="Emitir medida de requerimiento con firma digital">
      <bpmn:incoming>Flow_PR01_TOBE_10</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PR01_TOBE_t6" name="Subsanar y acreditar en línea">
      <bpmn:incoming>Flow_PR01_TOBE_12</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PR01_TOBE_x2" name="¿Subsanó?">
      <bpmn:incoming>Flow_PR01_TOBE_13</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR01_TOBE_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PR01_TOBE_st5" name="Registrar cumplimiento y generar informe automático">
      <bpmn:incoming>Flow_PR01_TOBE_11</bpmn:incoming>
      <bpmn:incoming>Flow_PR01_TOBE_15</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PR01_TOBE_e2" name="Actuación concluida (cumplimiento)">
      <bpmn:incoming>Flow_PR01_TOBE_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PR01_TOBE_t7" name="Generar acta de infracción con plantilla y firma digital">
      <bpmn:incoming>Flow_PR01_TOBE_14</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PR01_TOBE_t8" name="Aprobar acta en bandeja digital">
      <bpmn:incoming>Flow_PR01_TOBE_17</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR01_TOBE_st4" name="Derivar expediente electrónico al PAS">
      <bpmn:incoming>Flow_PR01_TOBE_18</bpmn:incoming>
      <bpmn:outgoing>Flow_PR01_TOBE_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PR01_TOBE_e1" name="Expediente electrónico derivado">
      <bpmn:incoming>Flow_PR01_TOBE_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_1" sourceRef="PR01_TOBE_s" targetRef="PR01_TOBE_st1" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_2" sourceRef="PR01_TOBE_st1" targetRef="PR01_TOBE_st2" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_3" sourceRef="PR01_TOBE_st2" targetRef="PR01_TOBE_t1" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_4" sourceRef="PR01_TOBE_t1" targetRef="PR01_TOBE_t2" />
