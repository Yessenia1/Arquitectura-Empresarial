    <bpmn:sequenceFlow id="Flow_PR01_TOBE_11" name="No" sourceRef="PR01_TOBE_x1" targetRef="PR01_TOBE_st5" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_12" sourceRef="PR01_TOBE_t5" targetRef="PR01_TOBE_t6" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_13" sourceRef="PR01_TOBE_t6" targetRef="PR01_TOBE_x2" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_14" name="No" sourceRef="PR01_TOBE_x2" targetRef="PR01_TOBE_t7" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_15" name="Sí" sourceRef="PR01_TOBE_x2" targetRef="PR01_TOBE_st5" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_16" sourceRef="PR01_TOBE_st5" targetRef="PR01_TOBE_e2" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_17" sourceRef="PR01_TOBE_t7" targetRef="PR01_TOBE_t8" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_18" sourceRef="PR01_TOBE_t8" targetRef="PR01_TOBE_st4" />
    <bpmn:sequenceFlow id="Flow_PR01_TOBE_19" sourceRef="PR01_TOBE_st4" targetRef="PR01_TOBE_e1" />
    <bpmn:textAnnotation id="Ann_PR01_TOBE_1"><bpmn:text>Asignación automática: equilibra la carga</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR01_TOBE_1" associationDirection="None" sourceRef="Ann_PR01_TOBE_1" targetRef="PR01_TOBE_st1" />
    <bpmn:textAnnotation id="Ann_PR01_TOBE_2"><bpmn:text>Interoperabilidad: sin consultas manuales</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR01_TOBE_2" associationDirection="None" sourceRef="Ann_PR01_TOBE_2" targetRef="PR01_TOBE_st2" />
    <bpmn:textAnnotation id="Ann_PR01_TOBE_3"><bpmn:text>Actas digitales: se elimina la re-digitación</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR01_TOBE_3" associationDirection="None" sourceRef="Ann_PR01_TOBE_3" targetRef="PR01_TOBE_t2" />
    <bpmn:textAnnotation id="Ann_PR01_TOBE_4"><bpmn:text>Validación automática de documentos</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR01_TOBE_4" associationDirection="None" sourceRef="Ann_PR01_TOBE_4" targetRef="PR01_TOBE_st3" />
  </bpmn:process>
