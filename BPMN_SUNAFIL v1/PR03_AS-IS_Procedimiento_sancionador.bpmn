<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR03_ASIS" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR03_ASIS">
    <bpmn:documentation></bpmn:documentation>
    <bpmn:participant id="Participant_PR03_ASIS" name="SUNAFIL - PR03 Procedimiento administrativo sancionador (AS-IS)" processRef="Process_PR03_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR03_ASIS" name="PR03 AS-IS - Procedimiento administrativo sancionador" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR03_ASIS">
      <bpmn:lane id="Lane_PR03_ASIS_MP" name="Mesa de partes / Notificaciones">
        <bpmn:flowNodeRef>PR03_ASIS_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR03_ASIS_INST" name="Autoridad instructora">
        <bpmn:flowNodeRef>PR03_ASIS_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR03_ASIS_EMP" name="Empleador">
        <bpmn:flowNodeRef>PR03_ASIS_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_x1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR03_ASIS_SANC" name="Autoridad sancionadora">
        <bpmn:flowNodeRef>PR03_ASIS_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_ASIS_e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR03_ASIS_s" name="Acta de infracción y expediente recibidos">
      <bpmn:outgoing>Flow_PR03_ASIS_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="PR03_ASIS_t1" name="Registrar expediente físico/escaneado">
      <bpmn:incoming>Flow_PR03_ASIS_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="PR03_ASIS_t2" name="Evaluar acta y emitir imputación de cargos">
      <bpmn:incoming>Flow_PR03_ASIS_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="PR03_ASIS_t3" name="Notificar imputación (casilla o cédula física)">
      <bpmn:incoming>Flow_PR03_ASIS_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR03_ASIS_t4" name="Presentar descargos">
      <bpmn:incoming>Flow_PR03_ASIS_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="PR03_ASIS_t5" name="Elaborar informe final de instrucción">
      <bpmn:incoming>Flow_PR03_ASIS_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="PR03_ASIS_t6" name="Notificar informe final">
      <bpmn:incoming>Flow_PR03_ASIS_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR03_ASIS_t7" name="Presentar descargos al informe final">
      <bpmn:incoming>Flow_PR03_ASIS_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR03_ASIS_t8" name="Calcular multa y emitir resolución de sanción">
      <bpmn:incoming>Flow_PR03_ASIS_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="PR03_ASIS_t9" name="Notificar resolución de sanción">
      <bpmn:incoming>Flow_PR03_ASIS_9</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="PR03_ASIS_x1" name="¿Interpone recurso?">
      <bpmn:incoming>Flow_PR03_ASIS_10</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR03_ASIS_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PR03_ASIS_t10" name="Elevar expediente a 2.ª instancia / TFL">
      <bpmn:incoming>Flow_PR03_ASIS_11</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PR03_ASIS_e1" name="Expediente en apelación">
      <bpmn:incoming>Flow_PR03_ASIS_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PR03_ASIS_t11" name="Remitir a ejecución coactiva">
      <bpmn:incoming>Flow_PR03_ASIS_12</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_ASIS_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PR03_ASIS_e2" name="Multa en cobranza">
      <bpmn:incoming>Flow_PR03_ASIS_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_1" sourceRef="PR03_ASIS_s" targetRef="PR03_ASIS_t1" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_2" sourceRef="PR03_ASIS_t1" targetRef="PR03_ASIS_t2" />
