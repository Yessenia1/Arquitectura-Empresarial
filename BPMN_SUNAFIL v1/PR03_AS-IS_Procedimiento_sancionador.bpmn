    <bpmn:sequenceFlow id="Flow_PR03_ASIS_7" sourceRef="PR03_ASIS_t6" targetRef="PR03_ASIS_t7" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_8" sourceRef="PR03_ASIS_t7" targetRef="PR03_ASIS_t8" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_9" sourceRef="PR03_ASIS_t8" targetRef="PR03_ASIS_t9" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_10" sourceRef="PR03_ASIS_t9" targetRef="PR03_ASIS_x1" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_11" name="Sí" sourceRef="PR03_ASIS_x1" targetRef="PR03_ASIS_t10" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_12" name="No" sourceRef="PR03_ASIS_x1" targetRef="PR03_ASIS_t11" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_13" sourceRef="PR03_ASIS_t10" targetRef="PR03_ASIS_e1" />
    <bpmn:sequenceFlow id="Flow_PR03_ASIS_14" sourceRef="PR03_ASIS_t11" targetRef="PR03_ASIS_e2" />
    <bpmn:textAnnotation id="Ann_PR03_ASIS_1"><bpmn:text>Expediente en papel o escaneado</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR03_ASIS_1" associationDirection="None" sourceRef="Ann_PR03_ASIS_1" targetRef="PR03_ASIS_t1" />
    <bpmn:textAnnotation id="Ann_PR03_ASIS_2"><bpmn:text>Notificaciones observadas: riesgo de nulidad</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR03_ASIS_2" associationDirection="None" sourceRef="Ann_PR03_ASIS_2" targetRef="PR03_ASIS_t3" />
    <bpmn:textAnnotation id="Ann_PR03_ASIS_3"><bpmn:text>Notificación manual repetida</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR03_ASIS_3" associationDirection="None" sourceRef="Ann_PR03_ASIS_3" targetRef="PR03_ASIS_t6" />
    <bpmn:textAnnotation id="Ann_PR03_ASIS_4"><bpmn:text>Cálculo manual de multa; plazos extensos</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR03_ASIS_4" associationDirection="None" sourceRef="Ann_PR03_ASIS_4" targetRef="PR03_ASIS_t8" />
  </bpmn:process>
