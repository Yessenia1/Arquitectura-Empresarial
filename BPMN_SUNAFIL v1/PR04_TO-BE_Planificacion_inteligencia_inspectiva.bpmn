<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR04_TOBE" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR04_TOBE">
    <bpmn:documentation></bpmn:documentation>
    <bpmn:participant id="Participant_PR04_TOBE" name="SUNAFIL - PR04 Planificación e inteligencia inspectiva (TO-BE)" processRef="Process_PR04_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR04_TOBE" name="PR04 TO-BE - Planificación e inteligencia inspectiva" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR04_TOBE">
      <bpmn:lane id="Lane_PR04_TOBE_SYS" name="Plataforma de analítica e inteligencia inspectiva (sistema)">
        <bpmn:flowNodeRef>PR04_TOBE_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_TOBE_st1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_TOBE_st2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_TOBE_st3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_TOBE_st4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR04_TOBE_DINI" name="Dirección de Inteligencia Inspectiva (DINI)">
        <bpmn:flowNodeRef>PR04_TOBE_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_TOBE_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_TOBE_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR04_TOBE_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR04_TOBE_INT" name="Intendencias (Lima y regiones)">
        <bpmn:flowNodeRef>PR04_TOBE_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR04_TOBE_s" name="Ciclo mensual de planificación">
      <bpmn:outgoing>Flow_PR04_TOBE_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_PR04_TOBE_s" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="PR04_TOBE_st1" name="Integrar datos (SUNAT, planilla, denuncias, actas)">
      <bpmn:incoming>Flow_PR04_TOBE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PR04_TOBE_st2" name="Calcular índice de riesgo por empleador">
      <bpmn:incoming>Flow_PR04_TOBE_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR04_TOBE_t1" name="Revisar ranking de riesgo y definir prioridades">
      <bpmn:incoming>Flow_PR04_TOBE_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PR04_TOBE_t2" name="Aprobar plan de operativos dinámico">
      <bpmn:incoming>Flow_PR04_TOBE_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR04_TOBE_st3" name="Generar órdenes de operativo y asignar a intendencias">
      <bpmn:incoming>Flow_PR04_TOBE_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR04_TOBE_t3" name="Ejecutar operativos (PR01)">
      <bpmn:incoming>Flow_PR04_TOBE_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR04_TOBE_st4" name="Actualizar tablero de resultados en tiempo real">
      <bpmn:incoming>Flow_PR04_TOBE_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR04_TOBE_t4" name="Evaluar efectividad y recalibrar el modelo">
      <bpmn:incoming>Flow_PR04_TOBE_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR04_TOBE_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PR04_TOBE_e" name="Plan de operativos actualizado">
      <bpmn:incoming>Flow_PR04_TOBE_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_1" sourceRef="PR04_TOBE_s" targetRef="PR04_TOBE_st1" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_2" sourceRef="PR04_TOBE_st1" targetRef="PR04_TOBE_st2" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_3" sourceRef="PR04_TOBE_st2" targetRef="PR04_TOBE_t1" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_4" sourceRef="PR04_TOBE_t1" targetRef="PR04_TOBE_t2" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_5" sourceRef="PR04_TOBE_t2" targetRef="PR04_TOBE_st3" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_6" sourceRef="PR04_TOBE_st3" targetRef="PR04_TOBE_t3" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_7" sourceRef="PR04_TOBE_t3" targetRef="PR04_TOBE_st4" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_8" sourceRef="PR04_TOBE_st4" targetRef="PR04_TOBE_t4" />
    <bpmn:sequenceFlow id="Flow_PR04_TOBE_9" sourceRef="PR04_TOBE_t4" targetRef="PR04_TOBE_e" />
    <bpmn:textAnnotation id="Ann_PR04_TOBE_1"><bpmn:text>Almacén de datos alimentado vía PIDE/API</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR04_TOBE_1" associationDirection="None" sourceRef="Ann_PR04_TOBE_1" targetRef="PR04_TOBE_st1" />
    <bpmn:textAnnotation id="Ann_PR04_TOBE_2"><bpmn:text>Modelo de riesgo explicable</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR04_TOBE_2" associationDirection="None" sourceRef="Ann_PR04_TOBE_2" targetRef="PR04_TOBE_st2" />
    <bpmn:textAnnotation id="Ann_PR04_TOBE_3"><bpmn:text>Tablero BI compartido con intendencias</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR04_TOBE_3" associationDirection="None" sourceRef="Ann_PR04_TOBE_3" targetRef="PR04_TOBE_st4" />
  </bpmn:process>
