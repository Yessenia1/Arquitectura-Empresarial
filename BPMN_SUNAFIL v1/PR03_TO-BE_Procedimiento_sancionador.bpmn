    <bpmn:sequenceFlow id="Flow_PR03_TOBE_11" name="Sí" sourceRef="PR03_TOBE_x1" targetRef="PR03_TOBE_st5" />
    <bpmn:sequenceFlow id="Flow_PR03_TOBE_12" name="No" sourceRef="PR03_TOBE_x1" targetRef="PR03_TOBE_st6" />
    <bpmn:sequenceFlow id="Flow_PR03_TOBE_13" sourceRef="PR03_TOBE_st5" targetRef="PR03_TOBE_e1" />
    <bpmn:sequenceFlow id="Flow_PR03_TOBE_14" sourceRef="PR03_TOBE_st6" targetRef="PR03_TOBE_e2" />
    <bpmn:textAnnotation id="Ann_PR03_TOBE_1"><bpmn:text>Control automático de plazos</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR03_TOBE_1" associationDirection="None" sourceRef="Ann_PR03_TOBE_1" targetRef="PR03_TOBE_st1" />
    <bpmn:textAnnotation id="Ann_PR03_TOBE_2"><bpmn:text>Notificación trazable con doble alerta</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR03_TOBE_2" associationDirection="None" sourceRef="Ann_PR03_TOBE_2" targetRef="PR03_TOBE_st2" />
  </bpmn:process>
