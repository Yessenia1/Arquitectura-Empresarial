<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR03_TOBE" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR03_TOBE">
    <bpmn:documentation></bpmn:documentation>
    <bpmn:participant id="Participant_PR03_TOBE" name="SUNAFIL - PR03 Procedimiento administrativo sancionador (TO-BE)" processRef="Process_PR03_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR03_TOBE" name="PR03 TO-BE - Procedimiento administrativo sancionador" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR03_TOBE">
      <bpmn:lane id="Lane_PR03_TOBE_SYS" name="Expediente sancionador electrónico (sistema)">
        <bpmn:flowNodeRef>PR03_TOBE_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_st1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_st2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_st3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_st4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_st5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_st6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR03_TOBE_INST" name="Autoridad instructora">
        <bpmn:flowNodeRef>PR03_TOBE_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR03_TOBE_SANC" name="Autoridad sancionadora">
        <bpmn:flowNodeRef>PR03_TOBE_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR03_TOBE_EMP" name="Empleador">
        <bpmn:flowNodeRef>PR03_TOBE_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR03_TOBE_x1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR03_TOBE_s" name="Expediente electrónico recibido desde PR01">
      <bpmn:outgoing>Flow_PR03_TOBE_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_PR03_TOBE_s" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="PR03_TOBE_st1" name="Registrar expediente y controlar plazos con alertas">
      <bpmn:incoming>Flow_PR03_TOBE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR03_TOBE_t1" name="Elaborar imputación con plantillas y precedentes del TFL">
      <bpmn:incoming>Flow_PR03_TOBE_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR03_TOBE_st2" name="Notificar por casilla con alertas a correo y celular">
      <bpmn:incoming>Flow_PR03_TOBE_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR03_TOBE_t2" name="Presentar descargos en línea">
      <bpmn:incoming>Flow_PR03_TOBE_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PR03_TOBE_t3" name="Elaborar informe final con cálculo automático de multa">
      <bpmn:incoming>Flow_PR03_TOBE_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR03_TOBE_st3" name="Notificar informe final por casilla">
      <bpmn:incoming>Flow_PR03_TOBE_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR03_TOBE_t4" name="Presentar descargos en línea">
      <bpmn:incoming>Flow_PR03_TOBE_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PR03_TOBE_t5" name="Emitir resolución con firma digital">
      <bpmn:incoming>Flow_PR03_TOBE_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR03_TOBE_st4" name="Notificar resolución y publicar en consulta de multas">
      <bpmn:incoming>Flow_PR03_TOBE_9</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PR03_TOBE_x1" name="¿Interpone recurso?">
      <bpmn:incoming>Flow_PR03_TOBE_10</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR03_TOBE_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PR03_TOBE_st5" name="Elevar expediente electrónico a 2.ª instancia / TFL">
      <bpmn:incoming>Flow_PR03_TOBE_11</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PR03_TOBE_e1" name="Expediente en apelación">
      <bpmn:incoming>Flow_PR03_TOBE_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="PR03_TOBE_st6" name="Generar deuda y habilitar pago en línea">
      <bpmn:incoming>Flow_PR03_TOBE_12</bpmn:incoming>
      <bpmn:outgoing>Flow_PR03_TOBE_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PR03_TOBE_e2" name="Multa en cobranza">
      <bpmn:incoming>Flow_PR03_TOBE_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PR03_TOBE_1" sourceRef="PR03_TOBE_s" targetRef="PR03_TOBE_st1" />
    <bpmn:sequenceFlow id="Flow_PR03_TOBE_2" sourceRef="PR03_TOBE_st1" targetRef="PR03_TOBE_t1" />
