<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR02_TOBE" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR02_TOBE">
    <bpmn:documentation></bpmn:documentation>
    <bpmn:participant id="Participant_PR02_TOBE" name="SUNAFIL - PR02 Registro y calificación de denuncias (TO-BE)" processRef="Process_PR02_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR02_TOBE" name="PR02 TO-BE - Registro y calificación de denuncias laborales" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR02_TOBE">
      <bpmn:lane id="Lane_PR02_TOBE_TRA" name="Trabajador / denunciante">
        <bpmn:flowNodeRef>PR02_TOBE_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR02_TOBE_SYS" name="Plataforma de denuncias con triaje inteligente (sistema)">
        <bpmn:flowNodeRef>PR02_TOBE_st1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_snd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_st2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_st3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_st4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_st5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR02_TOBE_AN" name="Analista de calificación">
        <bpmn:flowNodeRef>PR02_TOBE_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR02_TOBE_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR02_TOBE_SUP" name="Supervisor / Intendente">
        <bpmn:flowNodeRef>PR02_TOBE_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR02_TOBE_s" name="Trabajador decide denunciar">
      <bpmn:outgoing>Flow_PR02_TOBE_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PR02_TOBE_t1" name="Registrar denuncia en portal/app con validación DNI-RUC">
      <bpmn:incoming>Flow_PR02_TOBE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR02_TOBE_st1" name="Validar requisitos y competencia automáticamente">
      <bpmn:incoming>Flow_PR02_TOBE_2</bpmn:incoming>
      <bpmn:incoming>Flow_PR02_TOBE_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PR02_TOBE_x1" name="¿Denuncia válida?">
      <bpmn:incoming>Flow_PR02_TOBE_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR02_TOBE_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="PR02_TOBE_snd" name="Notificar observación al denunciante (correo/SMS)">
      <bpmn:incoming>Flow_PR02_TOBE_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="PR02_TOBE_t2" name="Subsanar observación en línea">
      <bpmn:incoming>Flow_PR02_TOBE_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR02_TOBE_st2" name="Clasificar materia y puntuar riesgo (modelo de IA)">
      <bpmn:incoming>Flow_PR02_TOBE_4</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PR02_TOBE_st3" name="Agrupar denuncias del mismo empleador">
      <bpmn:incoming>Flow_PR02_TOBE_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR02_TOBE_t3" name="Validar clasificación sugerida">
      <bpmn:incoming>Flow_PR02_TOBE_9</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PR02_TOBE_x2" name="¿Riesgo alto o materia grave?">
      <bpmn:incoming>Flow_PR02_TOBE_10</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR02_TOBE_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PR02_TOBE_st4" name="Generar orden de inspección prioritaria">
      <bpmn:incoming>Flow_PR02_TOBE_11</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PR02_TOBE_t4" name="Derivar a acción preventiva (PR05)">
      <bpmn:incoming>Flow_PR02_TOBE_12</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PR02_TOBE_e2" name="Derivada a prevención">
      <bpmn:incoming>Flow_PR02_TOBE_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PR02_TOBE_t5" name="Aprobar orden en bandeja digital">
      <bpmn:incoming>Flow_PR02_TOBE_14</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR02_TOBE_st5" name="Notificar estado al denunciante">
      <bpmn:incoming>Flow_PR02_TOBE_15</bpmn:incoming>
      <bpmn:outgoing>Flow_PR02_TOBE_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PR02_TOBE_e1" name="Orden de inspección emitida">
      <bpmn:incoming>Flow_PR02_TOBE_16</bpmn:incoming>
    </bpmn:endEvent>
