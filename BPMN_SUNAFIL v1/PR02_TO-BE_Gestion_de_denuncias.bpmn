    <bpmn:sequenceFlow id="Flow_PR02_TOBE_11" name="Sí" sourceRef="PR02_TOBE_x2" targetRef="PR02_TOBE_st4" />
    <bpmn:sequenceFlow id="Flow_PR02_TOBE_12" name="No" sourceRef="PR02_TOBE_x2" targetRef="PR02_TOBE_t4" />
    <bpmn:sequenceFlow id="Flow_PR02_TOBE_13" sourceRef="PR02_TOBE_t4" targetRef="PR02_TOBE_e2" />
    <bpmn:sequenceFlow id="Flow_PR02_TOBE_14" sourceRef="PR02_TOBE_st4" targetRef="PR02_TOBE_t5" />
