    <bpmn:sequenceFlow id="Flow_PR02_TOBE_16" sourceRef="PR02_TOBE_st5" targetRef="PR02_TOBE_e1" />
    <bpmn:textAnnotation id="Ann_PR02_TOBE_1"><bpmn:text>Validación de identidad y RUC en línea</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR02_TOBE_1" associationDirection="None" sourceRef="Ann_PR02_TOBE_1" targetRef="PR02_TOBE_t1" />
    <bpmn:textAnnotation id="Ann_PR02_TOBE_2"><bpmn:text>Requisitos validados por reglas</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR02_TOBE_2" associationDirection="None" sourceRef="Ann_PR02_TOBE_2" targetRef="PR02_TOBE_st1" />
    <bpmn:textAnnotation id="Ann_PR02_TOBE_3"><bpmn:text>Triaje IA: materia + puntaje de riesgo</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR02_TOBE_3" associationDirection="None" sourceRef="Ann_PR02_TOBE_3" targetRef="PR02_TOBE_st2" />
  </bpmn:process>
