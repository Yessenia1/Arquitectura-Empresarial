<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PR05_TOBE" targetNamespace="http://sunafil.gob.pe/bpmn" exporter="Informe AE TOGAF - SUNAFIL" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_PR05_TOBE">
    <bpmn:documentation></bpmn:documentation>
    <bpmn:participant id="Participant_PR05_TOBE" name="SUNAFIL - PR05 Orientación y prevención (TO-BE)" processRef="Process_PR05_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PR05_TOBE" name="PR05 TO-BE - Orientación y prevención del cumplimiento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PR05_TOBE">
      <bpmn:lane id="Lane_PR05_TOBE_CIU" name="Empleador / trabajador">
        <bpmn:flowNodeRef>PR05_TOBE_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR05_TOBE_SYS" name="Plataforma de prevención y cumplimiento (sistema)">
        <bpmn:flowNodeRef>PR05_TOBE_st1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_st2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_st3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PR05_TOBE_ORI" name="Orientador (Prevención y Promoción)">
        <bpmn:flowNodeRef>PR05_TOBE_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PR05_TOBE_e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PR05_TOBE_s" name="Necesidad de orientación o caso detectado">
      <bpmn:outgoing>Flow_PR05_TOBE_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PR05_TOBE_t1" name="Consultar en asistente virtual/portal o pedir asesoría">
      <bpmn:incoming>Flow_PR05_TOBE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR05_TOBE_st1" name="Responder con base de conocimiento y registrar caso">
      <bpmn:incoming>Flow_PR05_TOBE_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PR05_TOBE_x1" name="¿Posible incumplimiento?">
      <bpmn:incoming>Flow_PR05_TOBE_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR05_TOBE_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PR05_TOBE_e1" name="Consulta resuelta y registrada">
      <bpmn:incoming>Flow_PR05_TOBE_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="PR05_TOBE_st2" name="Enviar alerta preventiva con autodiagnóstico">
      <bpmn:incoming>Flow_PR05_TOBE_5</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="PR05_TOBE_t2" name="Completar autodiagnóstico y subsanar en plazo">
      <bpmn:incoming>Flow_PR05_TOBE_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PR05_TOBE_st3" name="Verificar subsanación cruzando planilla electrónica">
      <bpmn:incoming>Flow_PR05_TOBE_7</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PR05_TOBE_x2" name="¿Subsanó?">
      <bpmn:incoming>Flow_PR05_TOBE_8</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR05_TOBE_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PR05_TOBE_e2" name="Cumplimiento acreditado">
      <bpmn:incoming>Flow_PR05_TOBE_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PR05_TOBE_t3" name="Revisar caso y derivar a inspección (PR02)">
      <bpmn:incoming>Flow_PR05_TOBE_10</bpmn:incoming>
      <bpmn:outgoing>Flow_PR05_TOBE_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PR05_TOBE_e3" name="Derivado a fiscalización">
      <bpmn:incoming>Flow_PR05_TOBE_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_1" sourceRef="PR05_TOBE_s" targetRef="PR05_TOBE_t1" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_2" sourceRef="PR05_TOBE_t1" targetRef="PR05_TOBE_st1" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_3" sourceRef="PR05_TOBE_st1" targetRef="PR05_TOBE_x1" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_4" name="No" sourceRef="PR05_TOBE_x1" targetRef="PR05_TOBE_e1" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_5" name="Sí" sourceRef="PR05_TOBE_x1" targetRef="PR05_TOBE_st2" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_6" sourceRef="PR05_TOBE_st2" targetRef="PR05_TOBE_t2" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_7" sourceRef="PR05_TOBE_t2" targetRef="PR05_TOBE_st3" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_8" sourceRef="PR05_TOBE_st3" targetRef="PR05_TOBE_x2" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_9" name="Sí" sourceRef="PR05_TOBE_x2" targetRef="PR05_TOBE_e2" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_10" name="No" sourceRef="PR05_TOBE_x2" targetRef="PR05_TOBE_t3" />
    <bpmn:sequenceFlow id="Flow_PR05_TOBE_11" sourceRef="PR05_TOBE_t3" targetRef="PR05_TOBE_e3" />
    <bpmn:textAnnotation id="Ann_PR05_TOBE_1"><bpmn:text>Atención 24/7 multicanal</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR05_TOBE_1" associationDirection="None" sourceRef="Ann_PR05_TOBE_1" targetRef="PR05_TOBE_t1" />
    <bpmn:textAnnotation id="Ann_PR05_TOBE_2"><bpmn:text>Cada consulta queda registrada (dato para DINI)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR05_TOBE_2" associationDirection="None" sourceRef="Ann_PR05_TOBE_2" targetRef="PR05_TOBE_st1" />
    <bpmn:textAnnotation id="Ann_PR05_TOBE_3"><bpmn:text>Verificación automática de la subsanación</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_PR05_TOBE_3" associationDirection="None" sourceRef="Ann_PR05_TOBE_3" targetRef="PR05_TOBE_st3" />
  </bpmn:process>
